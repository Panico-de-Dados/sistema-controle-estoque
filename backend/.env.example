SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sua_service_role_key
PORT=3000
# Obrigatorio na Vercel. Use o mesmo valor no segredo BACKEND_API_TOKEN do Cloudflare Pages.
# Gere um valor longo e aleatorio; nao envie esse token ao GitHub.
# BACKEND_API_TOKEN=troque-por-um-token-longo-e-aleatorio
# Opcional: origens adicionais separadas por vírgula para usar outro servidor de frontend.
# FRONTEND_ORIGIN=http://localhost:5500,http://127.0.0.1:5500
